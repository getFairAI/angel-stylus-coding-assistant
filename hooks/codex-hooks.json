{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/stylus-check-hook.sh",
            "statusMessage": "Stylus verify (cargo check)",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
